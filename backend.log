CREATE TABLE finance_journal_entry_lines (
	id CHAR(32) NOT NULL, 
	created_at DATETIME NOT NULL, 
	updated_at DATETIME NOT NULL, 
	created_by VARCHAR, 
	subsidiary_id VARCHAR, 
	is_deleted BOOLEAN NOT NULL, 
	metadata_ JSON NOT NULL, 
	journal_entry_id CHAR(32) NOT NULL, 
	account_id CHAR(32) NOT NULL, 
	description VARCHAR NOT NULL, 
	debit NUMERIC(20, 4) NOT NULL, 
	credit NUMERIC(20, 4) NOT NULL, 
	PRIMARY KEY (id), 
	FOREIGN KEY(journal_entry_id) REFERENCES finance_journal_entries (id), 
	FOREIGN KEY(account_id) REFERENCES finance_accounts (id)
)


