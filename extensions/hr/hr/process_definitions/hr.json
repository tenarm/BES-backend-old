{
  "EMPLOYEE_EXIT": {
    "processId": "EMPLOYEE_EXIT",
    "module": "hr",
    "label": "Employee Exit Offboarding Pipeline",
    "entity": "employee_exit",
    "steps": [
      {
        "id": "fill_form",
        "label": "Exit Clearance Request Form",
        "type": "direct",
        "statusEvent": "exit_form_completed",
        "description": "Initiate process and collect exit details and reasons"
      },
      {
        "id": "hr_clearance",
        "label": "HR Clearance & Handover Review",
        "type": "approval",
        "statusEvent": "hr_clearance_approved",
        "dependsOn": [
          "fill_form"
        ],
        "requiredRole": "hr_admin",
        "description": "Verify employee handovers, exit interviews, and documentation"
      },
      {
        "id": "finance_settlement",
        "label": "Finance Settlement & Severance Approval",
        "type": "approval",
        "statusEvent": "finance_settlement_approved",
        "dependsOn": [
          "hr_clearance"
        ],
        "requiredRole": "finance_admin",
        "requiredModule": "finance",
        "description": "Recalculate final payout, severance packages, and tax deductions",
        "action": {
          "label": "Review & Approve Settlement",
          "apiEndpoint": "/api/v1/finance/settle-exit",
          "method": "POST"
        }
      },
      {
        "id": "asset_return",
        "label": "IT & Physical Asset Return Verification",
        "type": "approval",
        "statusEvent": "asset_returned",
        "dependsOn": [
          "finance_settlement"
        ],
        "requiredRole": "inventory_admin",
        "requiredModule": "inventory",
        "description": "Verify company laptops, keycards, and physical inventory clearance",
        "action": {
          "label": "Verify Asset Returns",
          "apiEndpoint": "/api/v1/inventory/verify-assets",
          "method": "POST"
        }
      },
      {
        "id": "system_deactivation",
        "label": "System Access & Email Account Deactivation",
        "type": "sequence",
        "statusEvent": "system_deactivated",
        "dependsOn": [
          "asset_return"
        ],
        "description": "Revoke corporate single sign-on (SSO), email, and server access"
      }
    ]
  }
}
